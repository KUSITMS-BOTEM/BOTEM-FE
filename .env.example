# 카카오 신규 유저(isNewUser: true) 온보딩 플로우를 MSW로 테스트할 때만 "1"로 설정 (src/mocks/)
NEXT_PUBLIC_MSW_ENABLED=

# Sentry 에러 수집 (src/lib/sentry.ts) — DSN은 공개돼도 되는 값이라 NEXT_PUBLIC_ 허용
NEXT_PUBLIC_SENTRY_DSN=
# 로컬에서도 Sentry로 보내려면 "1" (environment: local로 구분). Vercel 배포는 이 값과 무관하게 수집
NEXT_PUBLIC_SENTRY_LOCAL_ENABLED=
# 분산 추적 헤더(sentry-trace·baggage)를 붙일 API 도메인, 쉼표 구분. 백엔드 CORS가 두 헤더를 허용한 뒤에만 채울 것
NEXT_PUBLIC_SENTRY_TRACE_TARGETS=
# 빌드 시 소스맵 업로드용 (next.config.ts). 토큰은 비밀값이므로 절대 NEXT_PUBLIC_를 붙이지 말 것
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
