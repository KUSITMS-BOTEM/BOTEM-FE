harness_git() {
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE git -C .harness "$@"
}

# S<commit변경><수정><미추적> 중 commit변경(C)은 정상적인 포인터 갱신 커밋이라 허용하고,
# 수정(M)/미추적(U)만 "아직 .harness 안에 반영 안 된 변경"으로 차단한다.
harness_flags="$(git status --porcelain=v2 -- .harness | awk '{print $3}')"
case "$harness_flags" in
  *M*|*U*)
    echo "❌ .harness 서브모듈에 반영되지 않은 변경이 있습니다:"
    harness_git status --short
    echo ""
    echo "Claude Code에서 /harness-sync 실행 (또는 수동: cd .harness && git add . && git commit && git push)"
    exit 1
    ;;
esac

# submodule update는 항상 detached HEAD로 체크아웃하므로 @{u}가 없다.
# 대신 현재 HEAD 커밋이 origin의 어떤 브랜치에든 포함돼 있는지로 push 여부를 판단한다.
harness_pushed="$(harness_git branch -r --contains HEAD 2>/dev/null)"
if [ -z "$harness_pushed" ]; then
  echo "❌ .harness의 현재 커밋이 origin에 push되지 않았습니다 (cd .harness && git push)"
  exit 1
fi

pnpm exec lint-staged
